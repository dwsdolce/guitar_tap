# -*- mode: python ; coding: utf-8 -*-

import os
import sys

# Resolve the project root relative to this spec file's location (packaging/).
project_root = os.path.abspath(os.path.join(SPECPATH, '..'))

# PortAudio: on macOS and Windows the sounddevice package carries its own, which PyInstaller's hook
# collects; on Linux it carries none, so the build machine's is bundled.
added_binaries = []
if sys.platform.startswith('linux'):
    # The build machine's PortAudio (libportaudio2), carried beside the bundled Python so the app
    # needs no PortAudio on the user's system; models/audio_backend.py points sounddevice at it.
    # GT_PORTAUDIO_LIB names another; none found, the app relies on the system's.
    import glob
    if os.environ.get('GT_PORTAUDIO_LIB'):
        candidates = [os.environ['GT_PORTAUDIO_LIB']]
    else:
        candidates = sorted(glob.glob('/usr/lib/*/libportaudio.so.2')
                            + glob.glob('/usr/lib/libportaudio.so.2'))
    if candidates:
        added_binaries = [ (candidates[0], '.') ]

with open(os.path.join(project_root, 'src/guitar_tap/version'), 'r') as f:
    version = f.read().strip()

# 'version_build' is generated by gen_version_build.sh (git rev-list --count HEAD).
# It is not committed to git; when absent (dev builds) it defaults to '0'.
build_file = os.path.join(project_root, 'src/guitar_tap/version_build')
build = open(build_file).read().strip() if os.path.exists(build_file) else '0'

# Full version string: e.g. "1.0.245"
package_version = f'{version}.{build}'

print(f'Creating build for version {package_version}')

added_files = [
    (os.path.join(project_root, 'src/guitar_tap/icons/guitar-tap.ico'), '.'),
    (os.path.join(project_root, 'src/guitar_tap/icons'), 'icons'),
    # Liberation Sans, the font Linux draws the export in (SIL Open Font License).
    (os.path.join(project_root, 'src/guitar_tap/fonts'), 'fonts'),
    (os.path.join(project_root, 'src/guitar_tap/version'), '.'),
]

# Bundle 'version_build' file only if it exists (CI builds).
if os.path.exists(build_file):
    added_files.append((build_file, '.'))

a = Analysis(
    [os.path.join(project_root, 'src/guitar_tap/__main__.py')],
    # src (not src/guitar_tap): imports are package-absolute (`guitar_tap.…`), so the
    # package's PARENT must be on the path. Pointing at src/guitar_tap would also make
    # models/ and views/ importable as top-level packages, reintroducing the dual
    # module identity this layout exists to avoid.
    pathex=[os.path.join(project_root, 'src')],
    binaries=added_binaries,
    datas=added_files,
    # models/audio_backend.py loads sounddevice by name (so a failed PortAudio start does not fail the
    # import), which PyInstaller's import scan cannot see.
    hiddenimports=['sounddevice'],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    # scipy was replaced with numpy throughout the codebase
    # (commit c1de197).  Exclude it explicitly so a stray transitive
    # install never sneaks ~70 MB of unused code back into the bundle.
    excludes=['scipy'],
    noarchive=False,
)
if sys.platform.startswith('linux'):
    # ALSA's library is the system's: it reads the system's ALSA configuration and loads its plugins (the
    # PipeWire and PulseAudio bridges), which must match it — the AppImage exclusion list leaves it out
    # likewise. Every Linux with sound has it. (JACK's client library stays: PortAudio cannot load
    # without it, and it is harmless where no JACK server runs.)
    a.binaries = [b for b in a.binaries if not os.path.basename(b[0]).startswith('libasound.so')]
pyz = PYZ(a.pure)

exe_args = [pyz, a.scripts, []]

exe = EXE(
    *exe_args,
    exclude_binaries=True,
    name='guitar-tap',
    icon=os.path.join(project_root, 'src/guitar_tap/icons/guitar-tap.ico'),
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    # Opt-in, and read from the environment rather than hardcoded: this is a
    # public repository and a Developer ID does not belong in it. See
    # packaging/build_mac.
    codesign_identity=os.environ.get('CODESIGN_IDENTITY') or None,
    entitlements_file=os.path.join(SPECPATH, 'entitlements.plist'),
)

collect_args = [exe, a.binaries, a.datas]

coll = COLLECT(
    *collect_args,
    strip=False,
    upx=True,
    upx_exclude=[],
    name='guitar-tap',
)

app = BUNDLE(coll,
    name='Guitar Tap.app',
    icon=os.path.join(project_root, 'src/guitar_tap/icons/guitar-tap.icns'),
    version=package_version,
    bundle_identifier='com.dolcesfogato.guitar-tap',
    info_plist={
      'CFBundleName': 'Guitar Tap',
      'CFBundleDisplayName': 'Guitar Tap',
      'CFBundleVersion': package_version,          # e.g. "1.0.245"
      'CFBundleShortVersionString': package_version,  # e.g. "1.0.245"
      'NSPrincipalClass': 'NSApplication',
      'NSAppleScriptEnabled': False,
      'NSRequiresAquaSystemAppearance': 'No',
      'NSHighResolutionCapable': 'True',
      'NSMicrophoneUsageDescription': 'Guitar Tap from the audio inputs to show spectrum and peaks'
    },
)
