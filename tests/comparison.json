    {
     "load": "A"
    }
   ],
   "expect": {
    "mode": "live"
   }
  },
  {
   "id": "CM13",
   "note": "loading a measurement during a comparison ends the comparison",
   "steps": [
    {
     "compare": [
      "A",
      "B"
     ]
    },
    {
     "load": "A"
    }
   ],
   "expect": {
    "mode": "live",
    "entries": 0
   }
  },
  {
   "id": "CM14",
   "note": "entries with the same name are numbered",
   "steps": [
    {
     "compare": [
      "A",
      "A"
     ]
    }
   ],
   "expect": {
    "labels": [
     "A (1)",
     "A (2)"
    ]
   }
  },
  {
   "id": "CM15",
   "note": "comparing while the per-tap overlay is showing ends the overlay and its taps; the comparison is a saved-measurement one",
   "steps": [
    {
     "settings": {
      "type": "Generic Guitar"
     }
    },
    {
     "setTaps": 2
    },
    {
     "newTap": true
    },
    {
     "guitarTap": 100
    },
    {
     "advance": "tapCooldown"
    },
    {
     "guitarTap": 100
    },
    {
     "advance": "captureWindow"
    },
    {
     "multiTap": true
    },
    {
     "check": {
      "mode": "comparison",
      "multiTap": true,
      "savedComparison": false
     }
    },
    {
     "compare": [
      "A",
      "B"
     ]
    }
   ],
   "expect": {
    "multiTap": false,
    "tapEntries": 0,
    "savedComparison": true,
    "entries": 2,
    "mode": "comparison"
   }
  },
  {
   "id": "CM16",
   "note": "comparing without the overlay: a saved-measurement comparison",
   "steps": [
    {
     "compare": [
      "A"
     ]
    }
   ],
   "expect": {
    "multiTap": false,
    "savedComparison": true,
    "entries": 1
   }
  },
  {
   "id": "CM17",
   "note": "an entry's Air/Top/Back are its source's — the user's Top label and selection, not the auto Top",
   "steps": [
    {
     "settings": {
      "type": "Classical Guitar"
     }
    },
    {
     "compare": [
      "source"
     ]
    }
   ],
   "expect": {
    "modeIds": {
     "Air (Helmholtz)": "air",
     "Top": "far"
    },
    "entryPeaks": [
     "air",
     "far"
    ],
    "entryGuitarType": "Classical"
   }
  },
  {
   "id": "CM18",
   "note": "saving a comparison adds a comparison record with its entries and name",
   "steps": [
    {
     "compare": [
      "A",
      "B"
     ]
    },
    {
     "saveComparison": "Pair"
    }
   ],
   "expect": {
    "savedRecord": {
     "name": "Pair",
     "entries": 2
    }
   }
  },
  {
   "id": "CM19",
   "note": "with no comparison, saving one adds nothing",
