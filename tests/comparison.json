    {
     "saveComparison": "Nothing"
    }
   ],
   "expect": {
    "savedRecord": null
   }
  },
  {
   "id": "CM20",
   "note": "a saved comparison, loaded, keeps each entry's Air/Top/Back",
   "steps": [
    {
     "settings": {
      "type": "Classical Guitar"
     }
    },
    {
     "compare": [
      "source"
     ]
    },
    {
     "saveComparison": "Saved"
    },
    {
     "clearComparison": true
    },
    {
     "loadSaved": true
    }
   ],
   "expect": {
    "mode": "comparison",
    "modeIds": {
     "Air (Helmholtz)": "air",
     "Top": "far"
    }
   }
  },
  {
   "id": "CM21",
   "note": "New Tap ends a comparison (guitar)",
   "steps": [
    {
     "settings": {
      "type": "Generic Guitar"
     }
    },
    {
     "compare": [
      "A",
      "B"
     ]
    },
