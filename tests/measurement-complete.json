    "complete": true
   }
  },
  {
   "id": "MC2",
   "note": "completing freezes the spectrum",
   "steps": [
    {
     "captureTaps": [
      -30
     ]
    },
    {
     "processTaps": true
    }
   ],
   "expect": {
    "frozenSpectrum": true
   }
  },
  {
   "id": "MC3",
   "note": "two taps, averaged, complete it too",
   "steps": [
    {
     "numberOfTaps": 2
    },
