     "captureTaps": [
      -32,
      -28
     ]
    },
    {
     "processTaps": true
    }
   ],
   "expect": {
    "complete": true,
    "frozenSpectrum": true
   }
  },
  {
   "id": "MC4",
   "note": "a new sequence clears completion",
   "steps": [
    {
     "captureTaps": [
      -30
     ]
    },
    {
     "processTaps": true
    },
    {
     "newTap": true
    }
   ],
   "expect": {
    "complete": false
   }
  },
  {
   "id": "MC5",
   "note": "Cancel re-arms: the frozen spectrum goes, not complete, detecting",
   "steps": [
    {
     "captureTaps": [
      -30
     ]
    },
    {
     "processTaps": true
    },
    {
     "cancel": true
    }
   ],
   "expect": {
    "frozenSpectrum": false,
    "complete": false,
    "detecting": true
   }
  },
  {
   "id": "MC6",
   "note": "no captured taps: processing does not complete",
   "steps": [
    {
     "processTaps": true
    }
   ],
   "expect": {
    "complete": false
   }
  },
  {
   "id": "MC7",
   "note": "a load completes the measurement",
   "steps": [
    {
     "load": "inline-guitar"
    }
   ],
   "expect": {
    "complete": true
   }
  },
  {
   "id": "MC8",
   "note": "completing clears the loaded-settings warning",
   "steps": [
    {
     "warning": true
    },
    {
     "captureTaps": [
      -30
     ]
    },
    {
     "processTaps": true
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC9",
   "note": "a new sequence clears the loaded-settings warning",
   "steps": [
    {
     "warning": true
    },
    {
     "newTap": true
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC10",
   "note": "changing Taps clears the loaded-settings warning",
   "steps": [
    {
     "warning": true
    },
    {
     "setTaps": 3
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC11",
   "note": "a load raises the loaded-settings warning, after its completion clears it",
   "steps": [
    {
     "load": "inline-guitar"
    }
   ],
   "expect": {
    "complete": true,
    "loadedSettingsWarning": true
   }
  },
  {
   "id": "MC12",
   "note": "a load carrying a tap count applies it and still raises the warning",
