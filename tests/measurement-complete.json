    }
   ],
   "expect": {
    "numberOfTaps": 3,
    "loadedSettingsWarning": true
   }
  },
  {
   "id": "MC13",
   "note": "with nothing loaded, changing the threshold clears the loaded-settings warning",
   "steps": [
    {
     "warning": true
    },
    {
     "setThreshold": -50
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC14",
   "note": "after a load, setting Taps to the loaded count keeps the warning",
   "steps": [
    {
     "load": "inline-guitar-settings"
    },
    {
     "setTaps": 3
    }
   ],
   "expect": {
    "loadedSettingsWarning": true
   }
  },
  {
   "id": "MC15",
   "note": "after a load, a different Taps count clears the warning",
   "steps": [
    {
     "load": "inline-guitar-settings"
    },
    {
     "setTaps": 2
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC16",
   "note": "after a load, setting the threshold to the loaded one keeps the warning",
   "steps": [
    {
     "load": "inline-guitar-settings"
    },
    {
     "setThreshold": -45
    }
   ],
   "expect": {
    "loadedSettingsWarning": true
   }
  },
  {
   "id": "MC17",
   "note": "after a load, a different threshold clears the warning",
   "steps": [
    {
     "load": "inline-guitar-settings"
    },
    {
     "setThreshold": -50
    }
   ],
   "expect": {
    "loadedSettingsWarning": false
   }
  },
  {
   "id": "MC18",
