    "detectionState": "idle",
    "isMeasurementComplete": true,
    "displayMode": "live",
    "numberOfTaps": 1
   },
   "expect": {
    "pauseEnabled": false,
    "newTapDisabled": false,
    "cancelEnabled": false
   }
  },
  {
   "id": "B4",
