{
 "slug": "test/button-enablement",
 "about": "The Pause / New Tap / Cancel enablement rule (buttonRule), B1–B16, the same cases in every edition. 'state' gives only the fields a case sets; the rest take each edition's defaults (isReadyForDetection true, fftIsRunning true, measurementType generic, materialTapPhase notStarted, numberOfTaps 1, isPlayingFile false), so the run also checks the defaults agree. 'expect' lists the outputs a case checks. Names are Swift's. Expected values are Swift's.",
 "buttonRule": [
  {
   "id": "B1",
   "name": "guitar, disarmed idle: New Tap enabled to re-arm",
   "state": {
    "detectionState": "idle",
    "isMeasurementComplete": false,
    "displayMode": "live"
   },
   "expect": {
    "pauseEnabled": false,
    "newTapDisabled": false,
    "cancelEnabled": false
   }
  },
  {
   "id": "B2",
   "name": "guitar single tap, listening: Pause only",
   "state": {
    "detectionState": "listening",
    "isMeasurementComplete": false,
    "displayMode": "live",
    "numberOfTaps": 1
   },
   "expect": {
    "pauseEnabled": true,
    "newTapDisabled": true,
    "cancelEnabled": false
   }
  },
  {
