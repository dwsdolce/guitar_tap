    },
    {
     "advance": 2.9
    },
    {
     "spectrumFrame": {
      "kind": "gaussians",
      "binCount": 601,
      "binSpacingHz": 1,
      "noiseFloor": -100,
      "peaks": [
       {
        "peakHz": 150,
        "peakDB": -20,
        "halfWidthHz": 7
       }
      ]
     }
    }
   ],
   "expect": {
    "ready": false,
    "settling": true,
    "detecting": false,
    "statusMessage": "Audio device changed - reinitializing..."
   }
  },
